# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller / Build outputs
dist/
build/
installer/payload.zip
*.spec

# Test artifacts & heavy media files
tests/output/
tests/media/*.mov
tests/media/*.mp4
tests/media/*.mxf

# Large local binary downloads
bin/*.exe

# Environment & IDE
.env
.venv
venv/
ENV/
.idea/
.vscode/
*.swp
*.bak
